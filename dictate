#!/usr/bin/env python3
"""Push-to-talk dictation using faster-whisper and evdev.

Modes:
  dictate                         - push-to-talk (hold key to record, clipboard output)
  dictate --serve                 - daemon (model loaded, listens on Unix socket)
  dictate --serve --server H:P    - daemon forwarding audio to remote GPU server
  dictate --serve --listen H:P    - headless TCP transcription server (GPU machine)
  dictate --once                  - send record request to daemon, print text to stdout
"""

import argparse
import json
import os
import signal
import socket
import subprocess
import sys
try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib
from pathlib import Path
from selectors import DefaultSelector, EVENT_READ

import evdev
import numpy as np
import sounddevice as sd
from evdev import ecodes
from faster_whisper import WhisperModel

SAMPLE_RATE = 16000
CONFIG_PATH = os.path.expanduser("~/.config/dictate/config.toml")
SOCK_PATH = os.path.expanduser("~/.local/share/dictate/dictate.sock")
PID_PATH = os.path.expanduser("~/.local/share/dictate/dictate.pid")
LOG_PATH = os.path.expanduser("~/.local/share/dictate/transcriptions.log")
LANG_PATH = os.path.expanduser("~/.local/share/dictate/language")

DEFAULT_CONFIG = {
    "language": "en",
    "key": "RIGHTCTRL",
    "pre_buffer_secs": 1.0,
    "silence_secs": 3.0,
    "wait_secs": 10.0,
    "server": "",
}


def load_config():
    """Load config from TOML file, falling back to defaults."""
    config = dict(DEFAULT_CONFIG)
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, "rb") as f:
            user = tomllib.load(f)
        config.update(user)
    return config


def get_language(config):
    """Read language from state file, falling back to config."""
    if os.path.exists(LANG_PATH):
        lang = open(LANG_PATH).read().strip()
        if lang:
            return lang
    return config.get("language", "en")


def set_language(lang):
    """Write language to state file and show notification."""
    Path(LANG_PATH).parent.mkdir(parents=True, exist_ok=True)
    with open(LANG_PATH, "w") as f:
        f.write(lang)
    names = {"en": "English", "hi": "Hindi", "ja": "Japanese", "de": "German",
             "fr": "French", "es": "Spanish", "zh": "Chinese", "ko": "Korean"}
    name = names.get(lang, lang)
    subprocess.Popen(["notify-send", "-i", "audio-input-microphone", "-t", "2000",
                      "Dictate", f"Language: {name} ({lang})"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"Language set to {name} ({lang})")


GLOBAL_HINTS_DIR = os.path.expanduser("~/.config/dictate/hints.d")
LOCAL_HINTS_DIR = ".dictate-hints.d"


def _read_hints_file(path):
    """Read words from a single hints file."""
    with open(path) as f:
        return [line.strip() for line in f if line.strip() and not line.startswith("#")]


def _read_hints_dir(dirpath):
    """Read and merge all hint files in a directory."""
    words = []
    if not os.path.isdir(dirpath):
        return words
    for name in sorted(os.listdir(dirpath)):
        fpath = os.path.join(dirpath, name)
        if os.path.isfile(fpath):
            words.extend(_read_hints_file(fpath))
    return words


def load_hints():
    """Load vocabulary hints. Merges: ~/.config/dictate/hints.d/* + .dictate-hints.d/* in CWD.
    Returns initial_prompt string or None."""
    words = []
    words.extend(_read_hints_dir(GLOBAL_HINTS_DIR))
    words.extend(_read_hints_dir(os.path.join(os.getcwd(), LOCAL_HINTS_DIR)))
    # deduplicate preserving order
    seen = set()
    unique = []
    for w in words:
        if w.lower() not in seen:
            seen.add(w.lower())
            unique.append(w)
    if not unique:
        return None
    prompt = "Technical terms: " + ", ".join(unique) + "."
    return prompt


def find_audio_device():
    """Find the best input device, preferring pipewire."""
    devices = sd.query_devices()
    for i, dev in enumerate(devices):
        if dev['max_input_channels'] > 0 and 'pipewire' in dev['name'].lower():
            return i
    return None


def has_cuda():
    try:
        import ctranslate2
        return len(ctranslate2.get_supported_compute_types("cuda")) > 0
    except Exception:
        return False


def pick_defaults():
    if has_cuda():
        return "cuda", "int8", "medium"
    else:
        return "cpu", "int8", "small"


def find_keyboards():
    found = []
    devices = [evdev.InputDevice(path) for path in evdev.list_devices()]
    for dev in devices:
        caps = dev.capabilities(verbose=True)
        for (etype, _), codes in caps.items():
            if etype == "EV_KEY":
                key_names = [name for name, _ in codes]
                if "KEY_A" in key_names and "KEY_ENTER" in key_names:
                    found.append(dev)
                    break
    return found


def list_devices():
    devices = [evdev.InputDevice(path) for path in evdev.list_devices()]
    for dev in devices:
        if ecodes.EV_KEY in dev.capabilities():
            print(f"  {dev.path}: {dev.name}")


def calibrate_mic(audio_dev, retries=5, retry_delay=2):
    """Measure ambient noise for 0.5s and return speech threshold.
    Retries if mic returns silence (rms=0), which happens at boot before
    PipeWire audio routing is fully ready."""
    import time

    for attempt in range(retries):
        calibration_rms = []

        def cal_cb(indata, frames, time_info, status):
            calibration_rms.append(np.sqrt(np.mean(indata ** 2)))

        try:
            stream = sd.InputStream(
                samplerate=SAMPLE_RATE, channels=1, dtype="float32",
                callback=cal_cb, device=audio_dev,
            )
            stream.start()
            sd.sleep(500)
            stream.stop()
            stream.close()
        except Exception as e:
            if attempt < retries - 1:
                print(f"  Mic not ready ({e}), retrying in {retry_delay}s... ({attempt+1}/{retries})")
                time.sleep(retry_delay)
                continue
            raise

        ambient = np.mean(calibration_rms) if calibration_rms else 0.0
        if (ambient < 0.001 or ambient > 0.03) and attempt < retries - 1:
            reason = "silence" if ambient < 0.001 else "noisy (device switching?)"
            print(f"  Mic returning {reason} (rms={ambient:.4f}), retrying in {retry_delay}s... ({attempt+1}/{retries})")
            time.sleep(retry_delay)
            # Re-detect audio device — index may have changed
            audio_dev = find_audio_device()
            continue

        threshold = ambient * 1.5 + 0.01
        if threshold > 0.05:
            print(f"  WARNING: high ambient noise (rms={ambient:.4f}), capping threshold at 0.05 (was {threshold:.4f})")
            print(f"  Audio device may have changed during calibration.")
            threshold = 0.05
        elif ambient < 0.001:
            print(f"  WARNING: very low ambient level (rms={ambient:.4f}), mic may not be picking up audio.")
            print(f"  Check your microphone or try: dictate --list-devices")
        print(f"  ambient_rms={ambient:.4f}, threshold={threshold:.4f}")
        return threshold, audio_dev

    # All retries exhausted with silence — proceed with minimum threshold
    print(f"  WARNING: mic still silent after {retries} attempts, proceeding with minimum threshold")
    print(f"  Try unplugging and re-plugging your USB microphone.")
    print(f"  ambient_rms=0.0000, threshold=0.0100")
    return 0.01, audio_dev


STOP_FLAG = os.path.expanduser("~/.local/share/dictate/stop")


def record_until_silence(audio_dev, speech_threshold, silence_secs=3, wait_secs=10):
    """Record audio. Stop after silence_secs of post-speech silence,
    wait_secs of no speech, or STOP_FLAG file appearing."""
    import time as _time

    # Clear any stale stop flag
    if os.path.exists(STOP_FLAG):
        os.unlink(STOP_FLAG)

    audio_buffer = []
    is_recording = True
    speech_detected = False
    last_speech_time = _time.monotonic()
    start_time = _time.monotonic()
    max_rms = [0.0]
    callback_count = [0]

    def audio_cb(indata, frames, time_info, status):
        nonlocal speech_detected, last_speech_time, is_recording
        audio_buffer.append(indata.copy())
        rms = np.sqrt(np.mean(indata ** 2))
        callback_count[0] += 1
        if rms > max_rms[0]:
            max_rms[0] = rms
        now = _time.monotonic()
        if rms > speech_threshold:
            speech_detected = True
            last_speech_time = now
        elif speech_detected:
            if now - last_speech_time >= silence_secs:
                is_recording = False
        else:
            if now - start_time >= wait_secs:
                is_recording = False

    stream = sd.InputStream(
        samplerate=SAMPLE_RATE, channels=1, dtype="float32",
        callback=audio_cb, device=audio_dev,
    )
    stream.start()

    try:
        while is_recording:
            sd.sleep(100)
            # Check for manual stop
            if os.path.exists(STOP_FLAG):
                os.unlink(STOP_FLAG)
                speech_detected = True  # treat as valid recording
                break
    except KeyboardInterrupt:
        pass
    finally:
        stream.stop()
        stream.close()

    elapsed = _time.monotonic() - start_time
    if not audio_buffer or not speech_detected:
        print(f" [no-speech] elapsed={elapsed:.1f}s, callbacks={callback_count[0]}, max_rms={max_rms[0]:.4f}, threshold={speech_threshold:.4f}")
        return None

    return np.concatenate(audio_buffer, axis=0).flatten()


# ── Transcription ────────────────────────────────────────────────

def transcribe_audio(model, audio, language, initial_prompt, verbose=False):
    """Transcribe a float32 numpy audio array. Returns (text, metrics) tuple."""
    import time as _time
    t0 = _time.monotonic()
    segments, info = model.transcribe(
        audio, language=language,
        initial_prompt=initial_prompt,
        hallucination_silence_threshold=2,
    )
    seg_list = list(segments)
    text = " ".join(seg.text for seg in seg_list).strip()
    t1 = _time.monotonic()
    audio_duration = len(audio) / SAMPLE_RATE
    metrics = {
        "audio_duration": audio_duration,
        "seg_count": len(seg_list),
        "coverage": seg_list[-1].end / audio_duration if seg_list and audio_duration > 0 else 0,
        "avg_logprob": np.mean([s.avg_logprob for s in seg_list]) if seg_list else 0,
        "no_speech_prob": np.mean([s.no_speech_prob for s in seg_list]) if seg_list else 0,
        "compression_ratio": np.mean([s.compression_ratio for s in seg_list]) if seg_list else 0,
        "transcribe_time": t1 - t0,
    }
    print(f"  [transcribe] audio={audio_duration:.1f}s, segments={len(seg_list)}, time={t1-t0:.2f}s, lang={info.language}(p={info.language_probability:.2f})")
    print(f"  [metrics] cov={metrics['coverage']:.2f}, logp={metrics['avg_logprob']:.2f}, nsp={metrics['no_speech_prob']:.2f}, cr={metrics['compression_ratio']:.2f}")
    for i, seg in enumerate(seg_list):
        print(f"  [seg {i}] [{seg.start:.1f}s-{seg.end:.1f}s] {seg.text.strip()}")
    if seg_list and seg_list[-1].end < audio_duration - 1.0:
        print(f"  WARNING: last segment ends at {seg_list[-1].end:.1f}s but audio is {audio_duration:.1f}s — Whisper may have truncated")
    if verbose:
        print(f"[debug] transcribe took {t1-t0:.2f}s, detected_language={info.language} (p={info.language_probability:.2f})")
    return text, metrics


def transcribe_remote(server_addr, audio, language, initial_prompt):
    """Send audio to remote transcription server, return text."""
    import struct
    host, port = server_addr
    header = json.dumps({
        "language": language,
        "initial_prompt": initial_prompt or "",
        "audio_length": len(audio) * 4,  # float32 = 4 bytes
    }).encode()

    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.connect((host, port))
    try:
        sock.sendall(struct.pack(">I", len(header)))
        sock.sendall(header)
        sock.sendall(audio.astype(np.float32).tobytes())
        sock.shutdown(socket.SHUT_WR)

        buf = b""
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break
            buf += chunk
        resp = json.loads(buf.decode().strip())
        if "error" in resp:
            raise RuntimeError(f"Remote transcription error: {resp['error']}")
        return resp.get("text", "")
    finally:
        sock.close()


def parse_addr(addr_str):
    """Parse HOST:PORT string into (host, port) tuple."""
    host, port = addr_str.rsplit(":", 1)
    return (host, int(port))


# ── TCP transcription server (--serve --listen) ─────────────────

def serve_tcp(model, listen_addr, language, verbose=False):
    """Run headless TCP transcription server. No mic, no audio — receives audio over TCP."""
    import struct
    host, port = listen_addr

    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((host, port))
    server.listen(2)

    def cleanup(signum=None, frame=None):
        server.close()
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    print(f"TCP transcription server listening on {host}:{port}")
    print("Waiting for connections...\n")

    try:
        while True:
            conn, addr = server.accept()
            try:
                print(f"Connection from {addr[0]}:{addr[1]}")

                # Read header length (4 bytes, big-endian uint32)
                raw_len = b""
                while len(raw_len) < 4:
                    chunk = conn.recv(4 - len(raw_len))
                    if not chunk:
                        raise RuntimeError("Connection closed before header length")
                    raw_len += chunk
                header_len = struct.unpack(">I", raw_len)[0]

                # Read header
                raw_header = b""
                while len(raw_header) < header_len:
                    chunk = conn.recv(header_len - len(raw_header))
                    if not chunk:
                        raise RuntimeError("Connection closed before header")
                    raw_header += chunk
                header = json.loads(raw_header.decode())

                audio_length = header["audio_length"]
                lang = header.get("language", language)
                initial_prompt = header.get("initial_prompt", None) or None

                # Read audio bytes
                raw_audio = b""
                while len(raw_audio) < audio_length:
                    chunk = conn.recv(min(65536, audio_length - len(raw_audio)))
                    if not chunk:
                        raise RuntimeError("Connection closed before audio data")
                    raw_audio += chunk

                audio = np.frombuffer(raw_audio, dtype=np.float32)
                duration = len(audio) / SAMPLE_RATE
                print(f"  Audio: {duration:.1f}s, transcribing...", end="", flush=True)

                if verbose:
                    print(f"\n  [debug] language={lang}, initial_prompt={'[' + str(len(initial_prompt)) + ' chars]' if initial_prompt else 'None'}")

                text, metrics = transcribe_audio(model, audio, lang, initial_prompt, verbose)
                print(f" done.\n  > {text}\n")

                resp = json.dumps({"text": text}) + "\n"
                conn.sendall(resp.encode())
            except Exception as e:
                print(f"  error: {e}\n")
                try:
                    conn.sendall((json.dumps({"error": str(e)}) + "\n").encode())
                except Exception:
                    pass
            finally:
                conn.close()
    finally:
        cleanup()


# ── Daemon (--serve) ──────────────────────────────────────────────

def serve(model, language, audio_dev, config, initial_prompt, verbose=False, server_addr=None, model_name=None, model_device=None, model_compute=None):
    """Run as a background daemon. Listen on Unix socket for record requests."""
    speech_threshold, audio_dev = calibrate_mic(audio_dev)
    print(f"Mic calibrated. speech_threshold={speech_threshold:.4f}")
    if initial_prompt:
        print(f"Vocabulary hints loaded.")

    # Persistent audio stream with rolling pre-buffer
    from collections import deque
    import threading
    pre_buffer_secs = config.get("pre_buffer_secs", 1.0)
    pre_buffer_frames = int(pre_buffer_secs * SAMPLE_RATE / 1024) + 1
    pre_buffer = deque(maxlen=pre_buffer_frames)
    recent_rms = deque(maxlen=16)  # ~1s of RMS samples at 1024-block size
    # Recording state — when active, prebuf_callback accumulates audio
    rec_buffer = []
    rec_active = [False]
    rec_speech_detected = [False]
    rec_last_speech = [0.0]
    rec_start = [0.0]
    rec_max_rms = [0.0]
    rec_callbacks = [0]
    rec_silence_secs = [3.0]
    rec_wait_secs = [10.0]

    def prebuf_callback(indata, frames, time_info, status):
        import time as _time
        pre_buffer.append(indata.copy())
        rms = np.sqrt(np.mean(indata ** 2))
        recent_rms.append(rms)
        if rec_active[0]:
            rec_buffer.append(indata.copy())
            rec_callbacks[0] += 1
            if rms > rec_max_rms[0]:
                rec_max_rms[0] = rms
            now = _time.monotonic()
            if rms > speech_threshold:
                rec_speech_detected[0] = True
                rec_last_speech[0] = now
            elif rec_speech_detected[0]:
                if now - rec_last_speech[0] >= rec_silence_secs[0]:
                    print(f"\n  [rec-stop] silence timeout ({rec_silence_secs[0]}s after last speech)", flush=True)
                    rec_active[0] = False
            else:
                if now - rec_start[0] >= rec_wait_secs[0]:
                    print(f"\n  [rec-stop] wait timeout ({rec_wait_secs[0]}s, no speech detected)", flush=True)
                    rec_active[0] = False

    prebuf_stream = sd.InputStream(
        samplerate=SAMPLE_RATE, channels=1, dtype="float32",
        callback=prebuf_callback, device=audio_dev, blocksize=1024,
    )
    prebuf_stream.start()
    print("Pre-buffer stream started (1s rolling buffer).")

    # Monitor mic health — detect disconnects and re-calibrate on reconnect
    mic_healthy = True
    def notify(title, body, icon="dialog-warning"):
        subprocess.Popen(["notify-send", "-a", "Dictate", "-i", icon, title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def mic_monitor():
        nonlocal speech_threshold, audio_dev, mic_healthy
        import time
        silent_count = 0
        SILENT_THRESHOLD = 6  # require 6 consecutive silent checks (30s) before declaring lost
        while True:
            time.sleep(5)
            if not recent_rms:
                continue
            avg_rms = np.mean(list(recent_rms))
            if avg_rms < 0.0001:
                if mic_healthy:
                    silent_count += 1
                    if silent_count >= SILENT_THRESHOLD:
                        mic_healthy = False
                        silent_count = 0
                        print("WARNING: microphone went silent — disconnected or switched?")
                        notify("Microphone lost", "Dictate: mic returning silence. Reconnect your microphone.", "audio-input-microphone")
            else:
                silent_count = 0
                if not mic_healthy:
                    print("Microphone audio detected again, re-calibrating...")
                    try:
                        speech_threshold, audio_dev = calibrate_mic(audio_dev, retries=1)
                        print(f"Mic re-calibrated. speech_threshold={speech_threshold:.4f}")
                        notify("Microphone reconnected", f"Dictate: mic re-calibrated (threshold={speech_threshold:.4f}).", "audio-input-microphone")
                    except Exception as e:
                        print(f"Re-calibration failed: {e}")
                    mic_healthy = True

    threading.Thread(target=mic_monitor, daemon=True).start()

    Path(SOCK_PATH).parent.mkdir(parents=True, exist_ok=True)
    if os.path.exists(SOCK_PATH):
        os.unlink(SOCK_PATH)

    with open(PID_PATH, "w") as f:
        f.write(str(os.getpid()))

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCK_PATH)
    server.listen(1)

    def cleanup(signum=None, frame=None):
        prebuf_stream.stop()
        prebuf_stream.close()
        server.close()
        for p in (SOCK_PATH, PID_PATH):
            if os.path.exists(p):
                os.unlink(p)
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    def on_resume(signum, frame):
        from datetime import datetime
        ts = datetime.now().isoformat()
        print(f"\nSUSPEND/RESUME DETECTED (SIGUSR1) at {ts}")
        with open(LOG_PATH, "a") as lf:
            lf.write(f"\n--- SUSPEND/RESUME  {ts} ---\n")
    signal.signal(signal.SIGUSR1, on_resume)

    from datetime import datetime
    startup_ts = datetime.now().isoformat()
    with open(LOG_PATH, "a") as lf:
        lf.write(f"\n--- DAEMON STARTED  PID={os.getpid()}  {startup_ts} ---\n")
    print(f"Daemon ready. PID={os.getpid()}, socket={SOCK_PATH}")
    print("Waiting for requests...\n")

    try:
        while True:
            conn, _ = server.accept()
            try:
                chunks = []
                while True:
                    chunk = conn.recv(4096)
                    if not chunk:
                        break
                    chunks.append(chunk)
                data = b"".join(chunks).decode().strip()
                req = json.loads(data) if data else {}

                # Handle reload-model command
                if req.get("command") == "reload_model":
                    if model is not None and model_name:
                        import time as _time
                        print("Recreating model from scratch...")
                        t0 = _time.monotonic()
                        del model
                        model = WhisperModel(model_name, device=model_device, compute_type=model_compute)
                        elapsed = _time.monotonic() - t0
                        from datetime import datetime
                        with open(LOG_PATH, "a") as lf:
                            lf.write(f"\n--- MODEL RECREATED  PID={os.getpid()}  {elapsed:.1f}s  {datetime.now().isoformat()} ---\n")
                        print(f"Model recreated in {elapsed:.1f}s.")
                        conn.sendall(f"Model recreated in {elapsed:.1f}s.\n".encode())
                    else:
                        conn.sendall(b"No local model (forwarding mode).\n")
                    continue

                silence = req.get("silence_secs", config.get("silence_secs", 3))
                wait = req.get("wait_secs", config.get("wait_secs", 10))

                if verbose:
                    print(f"\n[debug] request: {len(data)} bytes, silence={silence}s, wait={wait}s")

                def send_status(status):
                    conn.sendall((json.dumps({"status": status}) + "\n").encode())

                # Grab pre-buffer snapshot and start recording via prebuf_callback
                import time as _time
                pre_audio = list(pre_buffer)
                if verbose:
                    pre_dur = sum(len(c) for c in pre_audio) / SAMPLE_RATE if pre_audio else 0
                    print(f"[debug] pre-buffer: {len(pre_audio)} chunks, {pre_dur:.2f}s")

                send_status("recording")
                print("● Recording...", end="", flush=True)

                # Clear stale stop flag from previous recording
                if os.path.exists(STOP_FLAG):
                    os.unlink(STOP_FLAG)

                # Start recording using the existing prebuf_stream (no second stream)
                rec_buffer.clear()
                rec_speech_detected[0] = False
                rec_last_speech[0] = _time.monotonic()
                rec_start[0] = _time.monotonic()
                rec_max_rms[0] = 0.0
                rec_callbacks[0] = 0
                rec_silence_secs[0] = silence
                rec_wait_secs[0] = wait
                rec_active[0] = True

                # Wait for recording to finish (silence detected, timeout, or STOP_FLAG)
                while rec_active[0]:
                    sd.sleep(100)
                    if os.path.exists(STOP_FLAG):
                        os.unlink(STOP_FLAG)
                        print(f"\n  [rec-stop] STOP_FLAG (key released)", flush=True)
                        rec_speech_detected[0] = True
                        rec_active[0] = False

                elapsed = _time.monotonic() - rec_start[0]
                print(f" [rec] elapsed={elapsed:.1f}s, callbacks={rec_callbacks[0]}, max_rms={rec_max_rms[0]:.4f}", end="", flush=True)
                if not rec_buffer or not rec_speech_detected[0]:
                    print(f" [no-speech] elapsed={elapsed:.1f}s, callbacks={rec_callbacks[0]}, max_rms={rec_max_rms[0]:.4f}, threshold={speech_threshold:.4f}")
                    print(" (no speech)\n")
                    from datetime import datetime
                    with open(LOG_PATH, "a") as lf:
                        lf.write(f"{datetime.now().isoformat()}\t(no speech detected, elapsed={elapsed:.1f}s, max_rms={rec_max_rms[0]:.4f}, threshold={speech_threshold:.4f})\n")
                    conn.sendall((json.dumps({"text": ""}) + "\n").encode())
                    continue

                # Prepend pre-buffer to recorded audio
                audio = np.concatenate(rec_buffer, axis=0).flatten()
                if pre_audio:
                    pre = np.concatenate(pre_audio, axis=0).flatten()
                    audio = np.concatenate([pre, audio])

                duration = len(audio) / SAMPLE_RATE
                rms = np.sqrt(np.mean(audio ** 2))
                send_status("transcribing")
                print(f" [{duration:.1f}s] transcribing...", end="", flush=True)
                if verbose:
                    print(f"\n[debug] audio: {duration:.2f}s, rms={rms:.4f}, threshold={speech_threshold:.4f}")

                lang = req.get("language", language)
                req_prompt = req.get("initial_prompt", initial_prompt)
                if verbose:
                    print(f"[debug] language={lang}")
                    print(f"[debug] initial_prompt={'[' + str(len(req_prompt)) + ' chars] ' + req_prompt[:80] + '...' if req_prompt else 'None'}")

                if server_addr:
                    text = transcribe_remote(server_addr, audio, lang, req_prompt)
                    metrics = None
                else:
                    text, metrics = transcribe_audio(model, audio, lang, req_prompt, verbose)

                print(f" done.\n> {text}\n")
                from datetime import datetime
                ts = datetime.now().isoformat()
                if text:
                    if metrics:
                        with open(LOG_PATH, "a") as lf:
                            lf.write(f"{ts}\tcov={metrics['coverage']:.2f}\tlogp={metrics['avg_logprob']:.2f}\tnsp={metrics['no_speech_prob']:.2f}\t{text}\n")
                    else:
                        with open(LOG_PATH, "a") as lf:
                            lf.write(f"{ts}\t{text}\n")
                else:
                    with open(LOG_PATH, "a") as lf:
                        lf.write(f"{ts}\t(empty transcription, audio={duration:.1f}s, rms={rms:.4f})\n")
                conn.sendall((json.dumps({"text": text}) + "\n").encode())
            except Exception as e:
                print(f" error: {e}\n")
                from datetime import datetime
                with open(LOG_PATH, "a") as lf:
                    lf.write(f"{datetime.now().isoformat()}\t(error: {e})\n")
                try:
                    conn.sendall(json.dumps({"error": str(e)}).encode())
                except Exception:
                    pass
            finally:
                conn.close()
    finally:
        cleanup()


# ── Client (--once) ───────────────────────────────────────────────

def client_once(language, status_callback=None, wait_secs=None, silence_secs=None):
    """Send a record request to the daemon and print the result.
    status_callback(status_str) is called for each status update.
    wait_secs/silence_secs override daemon's default timeouts."""
    if not os.path.exists(SOCK_PATH):
        print("Daemon not running. Start it with: dictate --serve", file=sys.stderr)
        sys.exit(1)

    # Load project-local hints from CWD
    initial_prompt = load_hints()

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(SOCK_PATH)
    req = {"language": language}
    if wait_secs is not None:
        req["wait_secs"] = wait_secs
    if silence_secs is not None:
        req["silence_secs"] = silence_secs
    if initial_prompt:
        req["initial_prompt"] = initial_prompt
    sock.sendall(json.dumps(req).encode())
    # Signal we're done sending
    sock.shutdown(socket.SHUT_WR)

    # Read newline-delimited JSON messages
    buf = b""
    text = ""
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            msg = json.loads(line.decode())
            if "status" in msg and status_callback:
                status_callback(msg["status"])
            elif "status" in msg:
                print(msg["status"], file=sys.stderr, flush=True)
            if "text" in msg:
                text = msg["text"]
    sock.close()

    if text:
        print(text)
    return text


# ── Push-to-talk client (--ptt) ──────────────────────────────────

SOUND_COMPLETE = "/usr/share/sounds/freedesktop/stereo/complete.oga"
SOUND_BELL = "/usr/share/sounds/freedesktop/stereo/bell.oga"


def play_sound(path):
    """Play a notification sound (non-blocking)."""
    if os.path.exists(path):
        subprocess.Popen(["pw-play", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def ptt_client(language, key_code, key_name, device_path):
    """Push-to-talk using the daemon. No model loading — sends requests to daemon."""
    import threading
    import time as _time

    # Auto-reap child processes (wl-copy, pw-play) to prevent zombies
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)

    wl_copy_proc = None

    def clipboard_copy(text):
        nonlocal wl_copy_proc
        if wl_copy_proc is not None:
            try:
                wl_copy_proc.kill()
            except OSError:
                pass
        wl_copy_proc = subprocess.Popen(["wl-copy", text],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def setup_keyboards():
        if device_path:
            kbds = [evdev.InputDevice(device_path)]
        else:
            kbds = find_keyboards()
        sel = DefaultSelector()
        for kbd in kbds:
            sel.register(kbd, EVENT_READ)
        return kbds, sel

    keyboards, selector = setup_keyboards()

    print("Push-to-talk (daemon mode). Listening on:")
    for kbd in keyboards:
        print(f"  {kbd.name} ({kbd.path})")
    print(f"Hold [{key_name}] to record, release to transcribe. Copies to clipboard.")
    print(f"Ctrl+C to quit.\n")

    t = None
    last_reconnect_check = 0
    try:
        while True:
            # If keyboards are missing, periodically try to re-add them
            if not selector.get_map():
                now = _time.time()
                if now - last_reconnect_check >= 2:
                    last_reconnect_check = now
                    try:
                        new_kbds = find_keyboards() if not device_path else [evdev.InputDevice(device_path)]
                        for kbd in new_kbds:
                            selector.register(kbd, EVENT_READ)
                            print(f"Keyboard reconnected: {kbd.name} ({kbd.path})")
                    except Exception:
                        pass
                if not selector.get_map():
                    _time.sleep(1)
                    continue

            ready = selector.select(timeout=2)
            if not ready:
                # Timeout — check for missing keyboards
                try:
                    new_kbds = find_keyboards() if not device_path else [evdev.InputDevice(device_path)]
                    registered = {sk.fileobj.path for sk in selector.get_map().values()}
                    for kbd in new_kbds:
                        if kbd.path not in registered:
                            selector.register(kbd, EVENT_READ)
                            print(f"Keyboard reconnected: {kbd.name} ({kbd.path})")
                except Exception:
                    pass
                continue

            for sel_key, _ in ready:
                dev = sel_key.fileobj
                try:
                    events = list(dev.read())
                except OSError:
                    print(f"Keyboard disconnected: {dev.name}")
                    try:
                        selector.unregister(dev)
                        dev.close()
                    except Exception:
                        pass
                    continue

                for event in events:
                    if event.type != ecodes.EV_KEY:
                        continue
                    key_event = evdev.categorize(event)
                    if key_event.scancode != key_code:
                        continue

                    if key_event.keystate == evdev.KeyEvent.key_down and t is None:
                        if not os.path.exists(SOCK_PATH):
                            print("Daemon not running. Start with: dictate --serve", file=sys.stderr)
                            continue
                        from datetime import datetime
                        key_down_time = _time.monotonic()
                        key_down_ts = datetime.now().isoformat(timespec='milliseconds')
                        print(f"● Recording... [press={key_down_ts}]", end="", flush=True)
                        result = {}
                        def do_once():
                            try:
                                lang = get_language(load_config())
                                result["text"] = client_once(lang, status_callback=lambda s: None, wait_secs=300, silence_secs=300)
                            except Exception as e:
                                result["error"] = str(e)
                        t = threading.Thread(target=do_once, daemon=True)
                        t.start()

                    elif key_event.keystate == evdev.KeyEvent.key_up and t is not None:
                        held_secs = _time.monotonic() - key_down_time
                        key_up_ts = datetime.now().isoformat(timespec='milliseconds')
                        print(f" [release={key_up_ts}]", end="", flush=True)
                        Path(STOP_FLAG).parent.mkdir(parents=True, exist_ok=True)
                        Path(STOP_FLAG).touch()
                        t.join()
                        t = None
                        if "error" in result:
                            print(f" [held={held_secs:.1f}s] error: {result['error']}\n", file=sys.stderr)
                            play_sound(SOUND_BELL)
                        elif result.get("text"):
                            clipboard_copy(result["text"])
                            print(f"[held={held_secs:.1f}s] done. [copied]\n> {result['text']}\n")
                            play_sound(SOUND_COMPLETE)
                        else:
                            print(f" [held={held_secs:.1f}s] (no speech detected)\n")
                            play_sound(SOUND_BELL)

    except KeyboardInterrupt:
        print("\nStopping.")


# ── Push-to-talk (default) ───────────────────────────────────────

def push_to_talk(model, language, key_code, key_name, keyboards, audio_dev, initial_prompt):
    audio_buffer = []
    is_recording = False

    def audio_callback(indata, frames, time_info, status):
        if is_recording:
            audio_buffer.append(indata.copy())

    stream = sd.InputStream(
        samplerate=SAMPLE_RATE, channels=1, dtype="float32",
        callback=audio_callback, device=audio_dev,
    )
    stream.start()

    print("Listening on:")
    for kbd in keyboards:
        print(f"  {kbd.name} ({kbd.path})")
    print(f"Hold [{key_name}] to record, release to transcribe.")
    print(f"Ctrl+C to quit.\n")

    selector = DefaultSelector()
    for kbd in keyboards:
        selector.register(kbd, EVENT_READ)

    try:
        while True:
            for sel_key, _ in selector.select():
                dev = sel_key.fileobj
                for event in dev.read():
                    if event.type != ecodes.EV_KEY:
                        continue
                    key_event = evdev.categorize(event)
                    if key_event.scancode != key_code:
                        continue

                    if key_event.keystate == evdev.KeyEvent.key_down and not is_recording:
                        audio_buffer.clear()
                        is_recording = True
                        print("● Recording...", end="", flush=True)

                    elif key_event.keystate == evdev.KeyEvent.key_up and is_recording:
                        is_recording = False

                        if not audio_buffer:
                            print(" (no audio captured)\n")
                            continue

                        audio = np.concatenate(audio_buffer, axis=0).flatten()
                        duration = len(audio) / SAMPLE_RATE
                        print(f" [{duration:.1f}s] transcribing...", end="", flush=True)

                        text, metrics = transcribe_audio(model, audio, language, initial_prompt)

                        if text:
                            subprocess.Popen(["wl-copy", text],
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            print(f" done. [copied]\n> {text}\n")
                        else:
                            print(" (no speech detected)\n")

    except KeyboardInterrupt:
        print("\nStopping.")
    finally:
        stream.stop()
        stream.close()


def main():
    config = load_config()
    hw_device, hw_compute, hw_model = pick_defaults()

    parser = argparse.ArgumentParser(description="Push-to-talk dictation")
    parser.add_argument("--key", default=config.get("key", "RIGHTCTRL"),
        help="Trigger key (default: from config)")
    parser.add_argument("--model", default=config.get("model", hw_model),
        help=f"Whisper model (default: {config.get('model', hw_model)})")
    parser.add_argument("--device", help="Input device path")
    parser.add_argument("--list-devices", action="store_true")
    parser.add_argument("--language", default=config.get("language", "en"),
        help="Language (default: from config)")
    parser.add_argument("--cpu", action="store_true", help="Force CPU")
    parser.add_argument("--serve", action="store_true",
        help="Run as background daemon (model stays loaded)")
    parser.add_argument("--once", action="store_true",
        help="Send record request to daemon, print result, exit")
    parser.add_argument("--ptt", action="store_true",
        help="Push-to-talk using daemon (no model loading, copies to clipboard)")
    parser.add_argument("--stop", action="store_true",
        help="Stop the running daemon")
    parser.add_argument("--reload-model", action="store_true",
        help="Tell daemon to recreate the Whisper model (clears all CTranslate2 state)")
    parser.add_argument("--stop-recording", action="store_true",
        help="Signal the daemon to stop current recording immediately")
    parser.add_argument("--listen",
        help="TCP listen address for remote transcription server (HOST:PORT)")
    parser.add_argument("--server",
        help="Forward audio to remote transcription server (HOST:PORT)")
    parser.add_argument("--lang", nargs="?", const="toggle", default=None,
        help="Set transcription language (e.g. --lang hi). No value toggles en↔hi.")
    parser.add_argument("--verbose", "-v", action="store_true",
        help="Enable debug logging")
    args = parser.parse_args()

    if args.list_devices:
        list_devices()
        return

    # --lang: set or toggle language
    if args.lang is not None:
        if args.lang == "toggle":
            cur = get_language(config)
            langs = config.get("languages", ["en", "hi"])
            try:
                idx = langs.index(cur)
                new_lang = langs[(idx + 1) % len(langs)]
            except ValueError:
                new_lang = langs[0]
        else:
            new_lang = args.lang
        set_language(new_lang)
        return

    # --once: just talk to daemon
    if args.once:
        lang = get_language(config) if args.language == config.get("language", "en") else args.language
        client_once(lang)
        return

    # --ptt: push-to-talk via daemon
    if args.ptt:
        key_name = f"KEY_{args.key.upper()}"
        key_code = getattr(ecodes, key_name, None)
        if key_code is None:
            print(f"Unknown key: {key_name}")
            sys.exit(1)
        if not args.device:
            keyboards = find_keyboards()
            if not keyboards:
                print("No keyboard found. Try --list-devices and --device.")
                sys.exit(1)
        ptt_client(args.language, key_code, args.key.upper(), args.device)
        return

    # --stop-recording: signal daemon to stop current recording
    if args.stop_recording:
        Path(STOP_FLAG).parent.mkdir(parents=True, exist_ok=True)
        Path(STOP_FLAG).touch()
        return

    # --stop: kill daemon
    if args.stop:
        if os.path.exists(PID_PATH):
            pid = int(open(PID_PATH).read().strip())
            os.kill(pid, signal.SIGTERM)
            print(f"Stopped daemon (PID {pid}).")
        else:
            print("No daemon running.")
        return

    # --reload-model: tell daemon to recreate the model
    if args.reload_model:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(SOCK_PATH)
            sock.sendall(json.dumps({"command": "reload_model"}).encode())
            sock.shutdown(socket.SHUT_WR)
            resp = sock.recv(4096).decode().strip()
            print(resp)
            sock.close()
        except ConnectionRefusedError:
            print("No daemon running.")
        return

    # Hardware setup
    if args.cpu:
        device, compute = "cpu", "int8"
    else:
        device, compute = hw_device, hw_compute

    # Resolve server address: CLI flag overrides config
    server_addr = None
    server_str = args.server or config.get("server", "")
    if server_str:
        server_addr = parse_addr(server_str)

    initial_prompt = load_hints()

    # --serve --listen: headless TCP transcription server (GPU machine)
    if args.serve and args.listen:
        listen_addr = parse_addr(args.listen)
        print(f"Loading whisper model '{args.model}' on {device} ({compute})...")
        model = WhisperModel(args.model, device=device, compute_type=compute)
        serve_tcp(model, listen_addr, args.language, args.verbose)
        return

    # --serve: daemon mode (local or forwarding)
    if args.serve:
        audio_dev = find_audio_device()
        if server_addr:
            print(f"Forwarding mode: audio will be sent to {server_addr[0]}:{server_addr[1]}")
            model = None
        else:
            print(f"Loading whisper model '{args.model}' on {device} ({compute})...")
            model = WhisperModel(args.model, device=device, compute_type=compute)
        serve(model, args.language, audio_dev, config, initial_prompt, args.verbose, server_addr,
              model_name=args.model, model_device=device, model_compute=compute)
        return

    # Default: push-to-talk (always local)
    audio_dev = find_audio_device()
    print(f"Loading whisper model '{args.model}' on {device} ({compute})...")
    model = WhisperModel(args.model, device=device, compute_type=compute)

    key_name = f"KEY_{args.key.upper()}"
    key_code = getattr(ecodes, key_name, None)
    if key_code is None:
        print(f"Unknown key: {key_name}")
        sys.exit(1)

    if args.device:
        keyboards = [evdev.InputDevice(args.device)]
    else:
        keyboards = find_keyboards()
        if not keyboards:
            print("No keyboard found. Try --list-devices and --device.")
            sys.exit(1)

    push_to_talk(model, args.language, key_code, args.key.upper(), keyboards, audio_dev, initial_prompt)


if __name__ == "__main__":
    main()
